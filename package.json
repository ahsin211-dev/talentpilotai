{
  "name": "talentpilotai",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first recruitment marketplace connecting overseas skilled tradespeople with Australian employers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:rls": "node --import tsx --test tests/rls/*.test.ts",
    "db:setup": "node --import tsx scripts/db-apply.ts",
    "db:reset": "node --import tsx scripts/db-apply.ts --reset",
    "worker": "node --import tsx scripts/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-kms": "^3.700.0",
