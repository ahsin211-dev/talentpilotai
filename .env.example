# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase service role. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AWS S3 document storage. Bucket policy should require SSE-KMS.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_DOCUMENT_BUCKET=talentpilotai-private-documents
S3_KMS_KEY_ID=arn:aws:kms:ap-southeast-2:123456789012:key/your-key-id

# AI / OCR providers
ANTHROPIC_API_KEY=your-anthropic-api-key
AWS_TEXTRACT_ROLE_ARN=arn:aws:iam::123456789012:role/textract-role

# Async jobs
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_EMPLOYER_PRICE_ID=price_...

# Outbound integrations configured in Phase 2
WHATSAPP_BUSINESS_API_TOKEN=
GOHIGHLEVEL_API_KEY=
RECRUITMENT_CRM_WEBHOOK_URL=
ESIGNATURE_API_KEY=
