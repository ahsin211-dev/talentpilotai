# =============================================================================
# TalentPilotAI — environment configuration
# Copy to `.env.local` for local development. NEVER commit real secrets.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase ---
# Public values: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Bypasses RLS. NEVER expose to the frontend / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection (migrations, worker, RLS tests).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/talentpilot

# --- AWS (S3 document storage with KMS encryption + Textract OCR) ---
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Encrypted private bucket for original/raw candidate documents.
S3_DOCUMENTS_BUCKET=talentpilot-candidate-documents
# KMS key used for SSE-KMS encryption of stored documents.
S3_KMS_KEY_ID=
# Seconds a signed URL stays valid.
S3_SIGNED_URL_TTL=300

# --- Anthropic Claude (extraction / rewrite / classification) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Upstash Redis (async job queue) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe (employer subscriptions) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STANDARD=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Integrations (Phase 2) ---
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_WEBHOOK_SECRET=
RECRUITMENT_CRM_API_KEY=
ESIGNATURE_API_KEY=

# --- Security ---
# Shared secret used to authenticate internal worker/cron callbacks.
INTERNAL_WORKER_SECRET=change-me-in-production
